  disponibilidad         disponibilidad      @relation(fields: [disponibilidad_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6998f923e80d667")
  taller                 taller              @relation(fields: [taller_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6998f926d9f5ea0")
  tipo_uso               tipo_uso            @relation(fields: [tipo_uso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6998f929ffda54b")
  persona_solicitante    persona_solicitante @relation(fields: [persona_solicitante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6998f92be49728e")
  codigo_descuento       codigo_descuento?   @relation(fields: [codigo_descuento_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6998f92f990e11a")

  @@schema("turnos")
}
