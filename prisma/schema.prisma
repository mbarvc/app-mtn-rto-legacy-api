  date_created              DateTime?            @db.Timestamp(6)
  domicilio                 String?              @db.VarChar(255)
  dominio                   String               @db.VarChar(255)
  fecha_creacion            DateTime             @db.Timestamp(6)
  fecha_inscripcion_inicial DateTime?            @db.Timestamp(6)
  last_updated              DateTime?            @db.Timestamp(6)
  last_updated_by           String?              @db.VarChar(255)
  localidad                 String?              @db.VarChar(255)
  marca_id                  BigInt?
  modelo_id                 BigInt?
  nacional                  Boolean
  nombre                    String?              @db.VarChar(255)
  nro_chasis                String               @db.VarChar(255)
  nro_documento             String?              @db.VarChar(255)
  nro_motor                 String?              @db.VarChar(255)
  porcentaje_titularidad    Int?
  provincia_id              BigInt?
  razon_social              String?              @db.VarChar(255)
  registro_id               BigInt
  tipo_documento            String?              @db.VarChar(255)
  tipo_persona              String?              @db.VarChar(255)
  tipo_vehiculo_id          BigInt?
  uso_id                    BigInt?
  last_call                 DateTime?            @db.Timestamp(6)
  marca                     marca?               @relation(fields: [marca_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d2a596d4d")
  tipo_vehiculo             dnrpa_tipo_vehiculo? @relation(fields: [tipo_vehiculo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d36632a38")
  registro                  registro             @relation(fields: [registro_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d86b304fb")
  uso                       uso?                 @relation(fields: [uso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d899850be")
  modelo                    modelo?              @relation(fields: [modelo_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d8d57fb15")
  provincia                 dnrpa_provincia?     @relation(fields: [provincia_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk6d8a794d9282be6b")
  planilla_revision         planilla_revision[]

  @@index([dominio], type: Hash)
  @@index([fecha_creacion(sort: Desc)])
  @@schema("dnrpa")
}

model marca {
  id                  BigInt    @id
